# Invoked as: cmake -P embed_lba2_cfg.cmake -DINPUT=<path> -DOUTPUT=<path> [-DLANGUAGE=<name>] [-DMODERN_PAD=ON]
# Emits C++ source with embedded LBA2.CFG bytes (no Python required).
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "embed_lba2_cfg.cmake requires -DINPUT= and -DOUTPUT=")
endif()

# LANGUAGE, when given, replaces the seed's text language (not LanguageCD), for a
# build whose players expect another language on a fresh install.
# MODERN_PAD, when true, seeds the Switch button layout and frees the D-pad's up
# and down for the camera zoom, as the compiled defaults of such a build do
# (INPUT_BINDINGS.CPP).
set(_edit FALSE)
if((DEFINED LANGUAGE AND NOT LANGUAGE STREQUAL "") OR MODERN_PAD)
    set(_edit TRUE)
    file(READ "${INPUT}" _text)
endif()
if(DEFINED LANGUAGE AND NOT LANGUAGE STREQUAL "")
    string(REGEX REPLACE "\nLanguage: [^\r\n]*" "\nLanguage: ${LANGUAGE}" _text "${_text}")
endif()
if(MODERN_PAD)
    # The Switch layout of INPUT_BINDINGS.CPP, in SDL's positional names: B
    # (1025, the Switch's A) talks, A (1024, its B) throws, Y (1027, its X) is
    # the behaviour's action, X (1026, its Y) the holomap, Back (1028, -) the
    # inventory, ZR (1048) the protection spell; D-pad down is the zoom.
    foreach(_pair "4:1024" "6:1028" "7:1027" "8:1025" "11:1026" "33:0" "34:1048")
        string(REPLACE ":" ";" _kv "${_pair}")
        list(GET _kv 0 _slot)
        list(GET _kv 1 _key)
        string(REGEX REPLACE "\nGamepad${_slot}: [^\r\n]*" "\nGamepad${_slot}: ${_key}" _text "${_text}")
    endforeach()
endif()
if(_edit)
    set(INPUT "${OUTPUT}.cfg")
    file(WRITE "${INPUT}" "${_text}")
endif()
file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _nbytes "${_hexlen} / 2")

set(_lines "// Generated by cmake/embed_lba2_cfg.cmake - do not edit\n")
string(APPEND _lines "#include <SYSTEM/ADELINE_TYPES.H>\n\n")
string(APPEND _lines "extern \"C\" const unsigned char g_embeddedLba2CfgBytes[] = {\n")

if(_nbytes EQUAL 0)
    string(APPEND _lines "\n")
else()
    math(EXPR _last "${_nbytes} - 1")
    set(_row "")
    set(_col 0)
    foreach(_i RANGE 0 ${_last})
        math(EXPR _off "${_i} * 2")
        string(SUBSTRING "${_hex}" ${_off} 2 _byte)
        if(_col GREATER 0)
            string(APPEND _row ", ")
        endif()
        string(APPEND _row "0x${_byte}")
        math(EXPR _col "${_col} + 1")
        if(_col EQUAL 16)
            string(APPEND _lines "    ${_row},\n")
            set(_row "")
            set(_col 0)
        endif()
    endforeach()
    if(_col GREATER 0)
        string(APPEND _lines "    ${_row},\n")
    endif()
endif()

string(APPEND _lines "};\n\n")
string(APPEND _lines "extern \"C\" const U32 g_embeddedLba2CfgBytesSize = (U32)sizeof(g_embeddedLba2CfgBytes);\n")

file(WRITE "${OUTPUT}" "${_lines}")
